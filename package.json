{
  "name": "@digitalmaas/vue-social-auth",
  "version": "0.1.0",
  "description": "Social OAuth 2.0 authentication for Vue 2.7+ and Vue 3. PKCE and server-side code exchange. No axios.",
  "license": "MIT",
  "author": "DigitalMaas",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.global.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "vue2",
    "oauth",
    "oauth2",
    "pkce",
    "social",
    "authentication",
    "google",
    "github",
    "facebook",
    "instagram"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^2.7.0 || >=3.0.0"
  },
  "dependencies": {
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "vue": "^3.4.0"
  }
}
