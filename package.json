{
  "name": "@digitalmaas/vue-social-auth",
  "version": "0.0.0",
  "description": "Social OAuth 2.0 authentication for Vue 2.7+ and Vue 3",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.global.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "vue2",
    "oauth",
    "oauth2",
    "pkce",
    "social",
    "authentication",
    "google",
    "github",
    "facebook",
    "instagram"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^2.7.0 || >=3.0.0"
  },
  "dependencies": {
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^24.0.0",
    "lefthook": "^1.6.0",
    "oxfmt": "^0.1.0",
    "oxlint": "^0.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "vue": "^3.4.0"
  },
  "contributors": [
    "Ricardo Nolde <12801563+nolde@users.noreply.github.com>",
    "Davor Grubelic <davor.grubelic@gmail.com>",
    "Andre-John Mas <andrejohn.mas+gh@gmail.com>"
  ],
  "author": "DigitalMaas (https://www.digitalmaas.com)"
}
